"""示例包 - 演示 reFun 包管理器功能"""

__version__ = "1.0.0"

def greet(name="World"):
    """打招呼函数"""
    return f"Hello, {name}! 欢迎使用 reFun!"

def calculate(a, b, op="+"):
    """简单计算器"""
    if op == "+":
        return a + b
    elif op == "-":
        return a - b
    elif op == "*":
        return a * b
    elif op == "/":
        return a / b if b != 0 else None
    else:
        raise ValueError(f"Unsupported operation: {op}")
